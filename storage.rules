rules_version = '2';
// RoadAssist Storage rules (M3): owner-only uploads, image-only, 8 MB cap.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    // `in`-guard mirrors firestore.rules: reading an absent custom claim is
    // an evaluation error rather than null, so without the guard every
    // claim-less caller errors instead of cleanly denying.
    function isClaimAdmin() {
      return isSignedIn() && ('admin' in request.auth.token) && request.auth.token.admin == true;
    }
    // NOTE: contentType is client-asserted — Storage rules cannot re-verify
    // image bytes. It is an upload gate, not a content guarantee; object
    // inspection (or a resize trigger) is the follow-up hardening step.
    function isSafeImage() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Per-user uploads (avatars, job photos): owner read/write, admins read.
    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isClaimAdmin();
      allow write: if isOwner(uid) && isSafeImage();
      allow delete: if isOwner(uid) || isClaimAdmin();
    }
    // Mechanic workshop photos: same owner discipline keyed by mechanic UID.
    match /mechanics/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isClaimAdmin();
      allow write: if isOwner(uid) && isSafeImage();
      allow delete: if isOwner(uid) || isClaimAdmin();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
