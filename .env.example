# RoadAssist frontend environment (M2).
# Copy to .env.local and fill in values from YOUR RoadAssist Firebase project:
# Firebase Console → Project settings → General → Your apps → Web app → Config.
# NEVER commit .env.local. NEVER put real values in this file.
# Do NOT use the MECHIST project (mechist-e0eba) here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ML ranking service (M11, optional). When unset/unreachable the app uses the
# deterministic M8 ordering. Example: http://localhost:8000
# VITE_ML_API_URL=
